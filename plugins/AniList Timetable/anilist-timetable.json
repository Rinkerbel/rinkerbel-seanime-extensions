{
	"id": "anilist-timetable",
	"name": "AniList Timetable",
	"version": "1.0.0",
	"manifestURI": "https://raw.githubusercontent.com/rinkerbel/rinkerbel-seanime-extensions/main/plugins/AniList%20Timetable/anilist-timetable.json",
	"language": "typescript",
	"type": "plugin",
	"description": "A week of AniList's airing schedule on Seanime's Schedule page, with your list.",
	"author": "rinkerbel",
	"icon": "https://raw.githubusercontent.com/rinkerbel/rinkerbel-seanime-extensions/main/plugins/AniList%20Timetable/icon.png",
	"website": "",
	"lang": "en",
	"readme": "",
	"payloadURI": "https://raw.githubusercontent.com/rinkerbel/rinkerbel-seanime-extensions/main/plugins/AniList%20Timetable/anilist-timetable.ts",
	"plugin": {
		"version": "1",
		"permissions": {
			"scopes": [
				"anilist",
				"storage"
			],
			"allow": {
				"networkAccess": {
					"allowedDomains": [
						"graphql.anilist.co"
					],
					"reasoning": "reads AniList's public airing schedule for the days the timetable shows"
				}
			}
		}
	}
}
